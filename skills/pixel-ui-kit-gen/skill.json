{
  "manifest_version": 1,
  "name": "pixel-ui-kit-gen",
  "version": "1.0.0",
  "description": "Split one batch UI sheet into separate raw component/state crops by projection-band detection over the magenta (#FF00FF) background.",
  "runtime": "python",
  "entrypoint": "main.py",
  "callable": "run",
  "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "input",
      "names"
    ],
    "properties": {
      "input": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "format": "asset-path"
      },
      "names": {
        "type": "string",
        "maxLength": 1000,
        "description": "comma-separated output names in reading order"
      },
      "bg": {
        "type": "string",
        "maxLength": 7,
        "default": "FF00FF"
      },
      "tol": {
        "type": "integer",
        "minimum": 1,
        "maximum": 441,
        "default": 60
      },
      "bridge": {
        "type": "integer",
        "minimum": 0,
        "maximum": 256,
        "default": 24
      },
      "margin": {
        "type": "integer",
        "minimum": 0,
        "maximum": 64,
        "default": 8
      }
    }
  },
  "output_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "piece_count",
      "width",
      "height"
    ],
    "properties": {
      "piece_count": {
        "type": "integer",
        "minimum": 0,
        "maximum": 64
      },
      "width": {
        "type": "integer",
        "minimum": 1
      },
      "height": {
        "type": "integer",
        "minimum": 1
      }
    }
  },
  "timeout": 30,
  "dependencies": {
    "python": [
      "Pillow",
      "numpy"
    ],
    "system": [],
    "requirements_file": "requirements.txt"
  },
  "permissions": {
    "filesystem": {
      "read": [
        "inputs"
      ],
      "write": [
        "outputs",
        "tmp"
      ]
    },
    "network": false
  },
  "limits": {
    "memory_mb": 512,
    "cpus": 1,
    "max_input_pixels": 16777216,
    "max_output_pixels": 16777216,
    "max_output_bytes": 16777216
  },
  "artifacts": {
    "media_types": [
      "image/png"
    ],
    "max_count": 16
  }
}
