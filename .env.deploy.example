# Bixel Studio — App Store deployment configuration.
#
# Copy to `.env.deploy` (gitignored) and fill in:
#   cp .env.deploy.example .env.deploy
#
# This file is read by scripts/publish-appstore.sh. The production RevenueCat
# public SDK key belongs in `.env`, not in this deployment credentials file.

# ---------------------------------------------------------------------------
# App identity / version
# ---------------------------------------------------------------------------
# 10-character Apple Developer Team ID (Membership page → Team ID).
DEVELOPMENT_TEAM=ABCDE12345

# Bundle identifier registered in App Store Connect.
APPSTORE_BUNDLE_ID=com.bixel.studio

# Marketing version (CFBundleShortVersionString) and build number (CFBundleVersion).
# Leave APPSTORE_BUILD_NUMBER empty to auto-use the git commit count.
APPSTORE_VERSION=1.0.0
APPSTORE_BUILD_NUMBER=1

# ---------------------------------------------------------------------------
# Code signing
# ---------------------------------------------------------------------------
# manual    — use the identities + provisioning profile named below
# automatic — let Xcode fetch/manage the profile (requires a signed-in account)
APPSTORE_SIGNING_STYLE=manual

# "Apple Distribution" for App Store. (Legacy: "3rd Party Mac Developer Application".)
APPSTORE_CODE_SIGN_IDENTITY="Apple Distribution"

# Name of the App Store provisioning profile installed in Xcode for the bundle id.
APPSTORE_PROVISIONING_PROFILE="Bixel Studio App Store"

# Installer cert used to sign the exported .pkg (usually auto-selected by Xcode).
APPSTORE_INSTALLER_SIGN_IDENTITY="3rd Party Mac Developer Installer"

# Path to the App Store entitlements file (App Sandbox + network + user files).
APPSTORE_ENTITLEMENTS=app/Bixel/Bixel-AppStore.entitlements

# ---------------------------------------------------------------------------
# App Store Connect authentication (choose ONE)
# ---------------------------------------------------------------------------
# Preferred: App Store Connect API key (Users and Access → Integrations → App Store
# Connect API). Put the downloaded .p8 in ./private_keys/ (gitignored) — altool
# looks for it there. The Key ID is the filename suffix: AuthKey_<KEYID>.p8.
APPSTORE_API_KEY_ID=
APPSTORE_API_ISSUER_ID=
# Optional: copy this .p8 into ./private_keys/ automatically before upload.
APPSTORE_API_KEY_PATH=

# Fallback: Apple ID + app-specific password (appleid.apple.com → Sign-In and
# Security → App-Specific Passwords).
APPSTORE_APPLE_ID=
APPSTORE_APP_SPECIFIC_PASSWORD=

# ---------------------------------------------------------------------------
# Upload behaviour
# ---------------------------------------------------------------------------
# 1 = build + validate the .pkg but do not upload to App Store Connect.
APPSTORE_SKIP_UPLOAD=0

# 1 = also create/update the git tag (vX.Y.Z) and push it to origin.
APPSTORE_GIT_PUSH=0

# Git remote to push the release tag to.
APPSTORE_GIT_REMOTE=origin
