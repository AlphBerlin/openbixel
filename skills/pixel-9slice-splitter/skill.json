{
  "manifest_version": 1,
  "name": "pixel-9slice-splitter",
  "version": "1.0.0",
  "description": "Validate and split a generated image into pieces — 9-slice UI panels, grid spritesheets, or scattered multi-object images — with an annotated cut-line preview.",
  "runtime": "python",
  "entrypoint": "main.py",
  "callable": "run",
  "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "input"
    ],
    "properties": {
      "input": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "format": "asset-path"
      },
      "mode": {
        "type": "string",
        "enum": [
          "auto",
          "grid",
          "nineslice",
          "scatter"
        ],
        "default": "auto"
      },
      "cols": {
        "type": "integer",
        "minimum": 0,
        "maximum": 32,
        "default": 0
      },
      "rows": {
        "type": "integer",
        "minimum": 0,
        "maximum": 32,
        "default": 0
      },
      "insets": {
        "type": "string",
        "maxLength": 40,
        "default": ""
      },
      "dilate": {
        "type": "integer",
        "minimum": 0,
        "maximum": 32,
        "default": 2
      },
      "min_area": {
        "type": "integer",
        "minimum": 1,
        "maximum": 1000000,
        "default": 32
      },
      "pad": {
        "type": "integer",
        "minimum": 0,
        "maximum": 64,
        "default": 2
      }
    }
  },
  "output_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "mode",
      "piece_count",
      "width",
      "height"
    ],
    "properties": {
      "mode": {
        "type": "string",
        "enum": [
          "auto",
          "grid",
          "nineslice",
          "scatter"
        ]
      },
      "piece_count": {
        "type": "integer",
        "minimum": 0,
        "maximum": 64
      },
      "width": {
        "type": "integer",
        "minimum": 1
      },
      "height": {
        "type": "integer",
        "minimum": 1
      },
      "warnings": {
        "type": "string",
        "maxLength": 2000,
        "default": ""
      }
    }
  },
  "timeout": 30,
  "dependencies": {
    "python": [
      "Pillow",
      "numpy",
      "scipy"
    ],
    "system": [],
    "requirements_file": "requirements.txt"
  },
  "permissions": {
    "filesystem": {
      "read": [
        "inputs"
      ],
      "write": [
        "outputs",
        "tmp"
      ]
    },
    "network": false
  },
  "limits": {
    "memory_mb": 512,
    "cpus": 1,
    "max_input_pixels": 16777216,
    "max_output_pixels": 16777216,
    "max_output_bytes": 16777216
  },
  "artifacts": {
    "media_types": [
      "image/png"
    ],
    "max_count": 16
  }
}
