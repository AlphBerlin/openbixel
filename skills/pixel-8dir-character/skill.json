{
  "manifest_version": 1,
  "name": "pixel-8dir-character",
  "version": "1.0.0",
  "description": "Pack 8-direction frames (N/NE/E/SE/S/SW/W/NW) into one canonical-order engine-ready spritesheet plus JSON and GIF preview.",
  "runtime": "python",
  "entrypoint": "main.py",
  "callable": "run",
  "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "input"
    ],
    "properties": {
      "input": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "format": "asset-path",
        "description": "S (front/facing camera) frame"
      },
      "frame_sw": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "format": "asset-path"
      },
      "frame_w": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "format": "asset-path"
      },
      "frame_nw": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "format": "asset-path"
      },
      "frame_n": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "format": "asset-path"
      },
      "frame_ne": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "format": "asset-path"
      },
      "frame_e": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "format": "asset-path"
      },
      "frame_se": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "format": "asset-path"
      },
      "layout": {
        "type": "string",
        "enum": [
          "8x1",
          "4x2",
          "2x4"
        ],
        "default": "8x1"
      },
      "fps": {
        "type": "number",
        "minimum": 0.5,
        "maximum": 60,
        "default": 4
      },
      "pad": {
        "type": "integer",
        "minimum": 0,
        "maximum": 32,
        "default": 0
      }
    }
  },
  "output_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "direction_count",
      "frame_width",
      "frame_height",
      "layout"
    ],
    "properties": {
      "direction_count": {
        "type": "integer",
        "minimum": 1,
        "maximum": 8
      },
      "frame_width": {
        "type": "integer",
        "minimum": 1
      },
      "frame_height": {
        "type": "integer",
        "minimum": 1
      },
      "layout": {
        "type": "string",
        "enum": [
          "8x1",
          "4x2",
          "2x4"
        ]
      }
    }
  },
  "timeout": 30,
  "dependencies": {
    "python": [
      "Pillow",
      "numpy"
    ],
    "system": [],
    "requirements_file": "requirements.txt"
  },
  "permissions": {
    "filesystem": {
      "read": [
        "inputs"
      ],
      "write": [
        "outputs",
        "tmp"
      ]
    },
    "network": false
  },
  "limits": {
    "memory_mb": 512,
    "cpus": 1,
    "max_input_pixels": 16777216,
    "max_output_pixels": 16777216,
    "max_output_bytes": 16777216
  },
  "artifacts": {
    "media_types": [
      "image/png",
      "image/gif"
    ],
    "max_count": 2
  }
}
