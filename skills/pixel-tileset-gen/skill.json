{
  "manifest_version": 1,
  "name": "pixel-tileset-gen",
  "version": "1.0.0",
  "description": "Verify seamlessness of a Wang autotile blob and slice it into individual tile PNGs, with a report of any bad seams.",
  "runtime": "python",
  "entrypoint": "main.py",
  "callable": "run",
  "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "input",
      "tile"
    ],
    "properties": {
      "input": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "format": "asset-path"
      },
      "tile": {
        "type": "integer",
        "minimum": 4,
        "maximum": 512,
        "description": "tile size in pixels (square)"
      },
      "cols": {
        "type": "integer",
        "minimum": 0,
        "maximum": 64,
        "default": 0
      },
      "rows": {
        "type": "integer",
        "minimum": 0,
        "maximum": 64,
        "default": 0
      },
      "tolerance": {
        "type": "number",
        "minimum": 1,
        "maximum": 441,
        "default": 24
      }
    }
  },
  "output_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "cols",
      "rows",
      "tile",
      "seams_total",
      "seams_bad",
      "ok_percent"
    ],
    "properties": {
      "cols": {
        "type": "integer",
        "minimum": 1
      },
      "rows": {
        "type": "integer",
        "minimum": 1
      },
      "tile": {
        "type": "integer",
        "minimum": 1
      },
      "seams_total": {
        "type": "integer",
        "minimum": 0
      },
      "seams_bad": {
        "type": "integer",
        "minimum": 0
      },
      "ok_percent": {
        "type": "number",
        "minimum": 0,
        "maximum": 100
      }
    }
  },
  "timeout": 30,
  "dependencies": {
    "python": [
      "Pillow",
      "numpy"
    ],
    "system": [],
    "requirements_file": "requirements.txt"
  },
  "permissions": {
    "filesystem": {
      "read": [
        "inputs"
      ],
      "write": [
        "outputs",
        "tmp"
      ]
    },
    "network": false
  },
  "limits": {
    "memory_mb": 512,
    "cpus": 1,
    "max_input_pixels": 16777216,
    "max_output_pixels": 16777216,
    "max_output_bytes": 16777216
  },
  "artifacts": {
    "media_types": [
      "image/png"
    ],
    "max_count": 64
  }
}
